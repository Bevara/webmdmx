{
    "name": "webmdmx",
    "description": "WebM/Matroska demultiplexer",
    "filters":["webmdmx"],
    "help": "This filter demultiplexes WebM/Matroska files using nestegg, exposing the AV1/VP8/VP9 video track (if any) for a downstream decoder (libaom for AV1, libvpx for VP8/VP9).",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/webmdmx.accessor",
    "filter_source":{
        "webmdmx" : "dmx_webm.c"
    },
    "Format": ["WebM"],
    "extension": {"webm": "video"},
    "using": ["solver_1"],
    "patents": {
        "status": "royalty-free",
        "note": "WebM/Matroska container",
        "checked": "2026-10-16"
    }
}
